# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Site profile
SITE_NAME=我的小站
SITE_AUTHOR=Eric
SITE_SIGNATURE=千里之行，始于足下
SITE_KEYWORDS=Python,Django,Blog
SITE_DESCRIPTION=这是一个基于 Django 的博客系统
SITE_LOGO=images/avatar.png
SITE_AVATAR=images/avatar.png
SITE_COPYRIGHT=Copyright © 2024 Eric
ALBUM_DESCRIPTION=分享点滴，记录美好
# ALBUM_HEADIMG=

# Structured settings are optional JSON values.
# SITE_SOCIAL={"GITHUB":{"icon":"fa-github","url":"https://github.com/your-name"}}
# SITE_VERIFICATION={"google":"", "baidu":""}

# Database. SQLite is the local default; Docker Compose overrides it to MySQL.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# MySQL settings used by docker compose
MYSQL_DATABASE=blog
MYSQL_USER=blog
MYSQL_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# Optional first-run administrator. Leave ADMIN_PASSWORD empty to create the
# account interactively after the container starts.
ADMIN_USERNAME=admin
ADMIN_NICKNAME=站长
ADMIN_PASSWORD=
INIT_ADMIN_FORCE=false
